# All knobs at both ends (pd ignores filter and resonance), the lowest and highest notes, bends, attack and
# release at the extremes, velocity 1 and 127.
tempo 120
steps 16
tail 0.5
track lead
preset 255 255 0 0 255 0 0 0 0 255 128 255 0 0 0 0 0 0
note 0 C0 4 127
note 4 C8 4 127
param p1 0 8
param p2 0 8
note 8 C2 4 1
param p1 255 12
param p2 109 12
note 12 G8 4 127
bend 12 200
bend 14 -200
expect peak_below 0
